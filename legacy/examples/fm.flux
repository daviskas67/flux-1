# FM-синтез на трёх квадратных каналах
# Канал 2 (carrier 220 Гц) модулируется каналом 0 (55 Гц), глубина 400 Гц -> кланг
# Волны в матрице переключают частоту канала 0 по мере прохождения ряда.

rate 44100
sps 735

# --- матрица: источник, генерирующий волны на восток каждые 3 такта ---
cell 0 5 : bit0 emit E 0      # генератор: пока нет бита, шлёт 1 вправо
cell 1 5 : bit1 send E 0      # проводник вправо

# на ряду y=5 последовательно меняем частоту модулятора:
# клетки x=3..6 ставят частоты LFO (секвенсор)
cell 3 5 : bit1 freq 0 55
cell 4 5 : bit1 freq 0 110
cell 5 5 : bit1 freq 0 165
cell 6 5 : bit1 freq 0 220
cell 7 5 : bit1 freq 0 330

# аккумулятор-флаг: волна, дошедшая до x=12, умирает (стоп)
cell 12 5 : bit1 stop

# --- звуковые каналы ---
chan 0 square freq 55   amp 0.5          # LFO-модулятор
chan 1 square freq 0    amp 0.0          # резерв (тихий)
chan 2 square freq 220  amp 0.6 mod 0 400 # несущая 220, FM глубина 400

# несущая канала 2 модулируется квадратом канала 0
# => слышим: 220 Гц + кланг/разбивка по спектру FM

steps 400